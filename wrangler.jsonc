{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "egx-repositor",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./prototype",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
